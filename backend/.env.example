# NVIDIA build (https://build.nvidia.com) — OpenAI 호환 API 키
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 채팅(도구 선택)·작성 모델. 같은 모델을 써도 된다.
# 2026-10-08 실측(도구 호출 지원, 응답 시간): nvidia/nemotron-3-super-120b-a12b 0.6s · nvidia/nemotron-3.5-lightning-30b-a3b 2.4s
#   · deepseek-ai/deepseek-v4.1-flash 3.1s · z-ai/glm-5.3-flash 7.9s · z-ai/glm-5.3 57s
CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
WRITER_MODEL=nvidia/nemotron-3-super-120b-a12b

# 예비 경로(선택) — NVIDIA 호출이 재시도 뒤에도 실패하면 같은 모델을 OpenRouter 로 한 번 더 부른다(데모 안정용).
# 키가 없으면 예비 경로 없음. 임베딩은 NVIDIA 그대로. https://openrouter.ai/keys
OPENROUTER_API_KEY=
FALLBACK_CHAT_MODEL=nvidia/nemotron-3.5-super-vl
FALLBACK_WRITER_MODEL=
# 호스트 고르기 — 순서(쉼표, 예: crusoe,nebius), 양자화 제한(기본 bf16,fp8 · 'any' 면 제한 없음),
# 데이터 수집 거부(deny — 맞는 호스트가 없으면 예비 호출이 실패할 수 있다)
OPENROUTER_PROVIDERS=
OPENROUTER_QUANTIZATIONS=bf16,fp8
OPENROUTER_DATA_COLLECTION=

# 임베딩 — 비우면 BM25(키워드) 검색만. nvidia/nemotron-3-embed-1b: 2048차원, 한·영 교차 검색 OK
EMBED_MODEL=nvidia/nemotron-3-embed-1b
# 벡터 저장소 — 비우면 로컬 모드(data/qdrant 폴더). Qdrant 서버를 쓰면 주소·키
QDRANT_URL=
QDRANT_API_KEY=

# 데이터 연결 — 비우면 그 연결은 화면에서 안내만 한다
# DART: https://opendart.fss.or.kr 무료 인증키
DART_API_KEY=
# SEC EDGAR: 키는 없지만 연락처가 든 User-Agent 필수(예: "Company Name contact@example.com")
SEC_USER_AGENT=
# 한국은행 ECOS: https://ecos.bok.or.kr 무료 인증키
ECOS_API_KEY=

# 저장 폴더(기본 backend/data), 프론트 주소(CORS), 업로드 상한
# DATA_DIR=
CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
MAX_UPLOAD_MB=50

# 관리자 계정(쉼표) — 전사 대시보드·시장 갱신·사내 수집 소스·품질 화면
ADMIN_USER_IDS=u_kim

# FRED(미 연준 경제 데이터) 무료 키 — 비우면 시장 시계열은 미 재무부·ECB·뉴욕 연은 실데이터와 데모(가상)로
FRED_API_KEY=

# 경제 일정·발표 감지 — 비우면 그 소스는 건너뛰고 FRED 로(발표 감지가 늦을 수 있음)
# BLS(미 노동통계국) 무료 등록키: https://data.bls.gov/registrationEngine/ — CPI·고용·PPI 발표 직후 감지
BLS_API_KEY=
# BEA(미 경제분석국) 무료 UserID: https://apps.bea.gov/API/signup/ — GDP·PCE 발표 직후 감지
BEA_API_KEY=
# KOSIS(통계청) 무료 인증키: https://kosis.kr/openapi — 선택(한국 지표는 대부분 ECOS 로 충분)
KOSIS_API_KEY=
# 공공데이터포털 '금융위원회_주식시세정보' 무료 키: https://www.data.go.kr — 선택(한국 주식 일봉 공식 대안, 다음 날 13시 이후 개방)
DATA_GO_KR_API_KEY=
# 일정 알림을 밖으로 보낼 웹훅(Slack·Teams 호환 — {"text": 메시지}) — 비우면 앱 알림함·워크스페이스 메시지만
ALERT_WEBHOOK_URL=
