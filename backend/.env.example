# NVIDIA build (https://build.nvidia.com) — OpenAI 호환 API 키
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 채팅(도구 선택)·작성 모델. 같은 모델을 써도 된다.
# 2026-10-08 실측(도구 호출 지원, 응답 시간): nvidia/nemotron-3-super-120b-a12b 0.6s · nvidia/nemotron-3.5-lightning-30b-a3b 2.4s
#   · deepseek-ai/deepseek-v4.1-flash 3.1s · z-ai/glm-5.3-flash 7.9s · z-ai/glm-5.3 57s
CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
WRITER_MODEL=nvidia/nemotron-3-super-120b-a12b

# 임베딩 — 비우면 BM25(키워드) 검색만. nvidia/nemotron-3-embed-1b: 2048차원, 한·영 교차 검색 OK
EMBED_MODEL=nvidia/nemotron-3-embed-1b
# 벡터 저장소 — 비우면 로컬 모드(data/qdrant 폴더). Qdrant 서버를 쓰면 주소·키
QDRANT_URL=
QDRANT_API_KEY=

# 데이터 연결 — 비우면 그 연결은 화면에서 안내만 한다
# DART: https://opendart.fss.or.kr 무료 인증키
DART_API_KEY=
# SEC EDGAR: 키는 없지만 연락처가 든 User-Agent 필수(예: "Company Name contact@example.com")
SEC_USER_AGENT=
# 한국은행 ECOS: https://ecos.bok.or.kr 무료 인증키
ECOS_API_KEY=

# 저장 폴더(기본 backend/data), 프론트 주소(CORS), 업로드 상한
# DATA_DIR=
CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
MAX_UPLOAD_MB=50
